# Keepa
KEEPA_API_KEY=

# Amazon Selling Partner API
AMAZON_REGION=na
# Sandbox returns static mocked data. Set production only after Amazon has
# approved the developer profile, the Product Listing role, and the app.
AMAZON_SP_API_ENVIRONMENT=sandbox
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_SP_API_APP_ID=
AMAZON_OAUTH_VERSION=beta
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=
# Shared only by the Cloudflare Worker and Render. It blocks direct origin
# traffic when configured in production; never put it in Expo or Git.
SCANNERAZ_EDGE_SHARED_SECRET=
# Required for Amazon routes in production. Keep server-side only; never use EXPO_PUBLIC_.
SCANNERAZ_OPERATOR_TOKEN=
# Keep both flags false until the public multi-tenant launch checklist is complete.
SCANNERAZ_PUBLIC_APP_ENABLED=false
SCANNERAZ_PUBLIC_SIGNUP_ENABLED=false
# Keep false until the authorized Amazon app has Pricing and Product Listing
# access and a controlled price-change pilot has been approved.
SCANNERAZ_PRICE_UPDATES_ENABLED=false

# Walmart
WALMART_CLIENT_ID=
WALMART_CLIENT_SECRET=

# Target
# Supported: public-web, unwrangle
TARGET_PROVIDER=public-web
TARGET_API_KEY=

# Warasoft AI Gateway. Keep the key only in the backend environment; it is
# never an EXPO_PUBLIC_ value and never belongs in the mobile app.
WARASOFT_AI_GATEWAY_URL=https://warasoft.com/api/ai/v1/responses/
WARASOFT_AI_GATEWAY_KEY=
WARASOFT_AI_INVOICE_MODEL=gpt-4o-mini
# Set only when the AI access key is scoped to a Warasoft project.
WARASOFT_AI_PROJECT=
INVOICE_EXTRACTION_TIMEOUT_MS=90000

# App
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
PORT=3000
DATABASE_URL=
# Set true only when your managed PostgreSQL endpoint requires TLS.
DATABASE_SSL=false
ENCRYPTION_KEY=
SESSION_SECRET=
