{
  "name": "scanneraz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc && rm -rf dist/public && cp -R public dist/public",
    "test:auth": "tsx --test src/auth/passwords.test.ts src/amazon/oauth.test.ts src/amazon/spapi.test.ts",
    "amazon:check": "tsx src/scripts/check-amazon-restrictions.ts",
    "export:target": "tsx src/scripts/export-target-clearance.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cheerio": "^0.22.35",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
